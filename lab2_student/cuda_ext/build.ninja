ninja_required_version = 1.3
cxx = c++
nvcc = /cm/shared/apps/cuda12.6/toolkit/12.6.2/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=dequant_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/lphung/miniconda3/lib/python3.13/site-packages/torch/include -isystem /home/lphung/miniconda3/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /cm/shared/apps/cuda12.6/toolkit/12.6.2/include -isystem /cm/shared/apps/cuda12.6/toolkit/12.6.2 -isystem /home/lphung/miniconda3/include/python3.13 -fPIC -std=c++17 -O3
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=dequant_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/lphung/miniconda3/lib/python3.13/site-packages/torch/include -isystem /home/lphung/miniconda3/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /cm/shared/apps/cuda12.6/toolkit/12.6.2/include -isystem /cm/shared/apps/cuda12.6/toolkit/12.6.2 -isystem /home/lphung/miniconda3/include/python3.13 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_80,code=sm_80 --compiler-options '-fPIC' --use_fast_math -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/lphung/miniconda3/lib/python3.13/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/cm/shared/apps/cuda12.6/toolkit/12.6.2/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build bindings.o: compile /home/lphung/ece341x-lab2/lab2_student/cuda_ext/bindings.cpp
build dequant_cuda.cuda.o: cuda_compile /home/lphung/ece341x-lab2/lab2_student/cuda_ext/dequant_cuda.cu





build dequant_ext.so: link bindings.o dequant_cuda.cuda.o

default dequant_ext.so
